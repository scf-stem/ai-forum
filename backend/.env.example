# AI开发者论坛后端 · 环境变量示例
# 复制本文件为 .env 并按需修改

# 数据库连接（异步驱动）
DATABASE_URL=postgresql+asyncpg://forum:forum@localhost:5432/forum

# Redis 连接
REDIS_URL=redis://localhost:6379/0

# JWT 鉴权配置（生产环境务必修改 JWT_SECRET）
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# 内容举报阈值：达到后进入待审队列
REPORT_THRESHOLD=5

# 跨域允许来源（多个用逗号分隔）
CORS_ORIGINS=["http://localhost:3000"]

# DeepSeek API
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Web Search API（可选，不配置则跳过联网检索）
WEB_SEARCH_API_URL=
WEB_SEARCH_API_KEY=

# AI 答案生成参数
AI_ANSWER_MAX_TOKENS=2048
AI_ANSWER_TEMPERATURE=0.3
